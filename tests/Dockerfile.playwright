# Playwright runner for the compose `test` profile.
#
#   docker compose --profile test run --rm playwright
#
# Talks to the musicdrome service over the compose network, so the suite runs
# against the same image you deploy rather than a local dev server.
FROM mcr.microsoft.com/playwright:v1.49.1-noble

WORKDIR /tests

COPY tests/package.json tests/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY tests/ ./

# E2E_BASE_URL is set by compose; when present the config skips its own
# webServer and points at the running container instead.
CMD ["npx", "playwright", "test"]
