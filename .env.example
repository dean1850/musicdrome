# ═══════════════════════════════════════════════════════════════════════════
#  Musicdrome — configuration
#  Copy to `.env` and edit.  Every runtime setting lives here.
#      cp .env.example .env
#  Generate the two secrets before first start:
#      python3 -c "import secrets; print(secrets.token_urlsafe(48))"   -> SECRET_KEY
#      python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                                                                     -> CREDENTIAL_ENCRYPTION_KEY
# ═══════════════════════════════════════════════════════════════════════════

# ─── Core server ───────────────────────────────────────────────────────────
MUSICDROME_PORT=4533
MUSICDROME_HOST=0.0.0.0
MUSICDROME_LOG_LEVEL=info
# Set only if serving under a sub-path behind a reverse proxy, e.g. /music
MUSICDROME_BASE_URL=
MUSICDROME_SERVER_NAME=Musicdrome
# Comma-separated origins for browser CORS. * is fine on a private LAN.
MUSICDROME_CORS_ORIGINS=*
# Number of uvicorn workers. Keep at 1 — SQLite + the scheduler are in-process.
MUSICDROME_WORKERS=1

TZ=UTC
PUID=1000
PGID=1000

# ─── Host paths (mounted into the container) ───────────────────────────────
# Your music library.
MUSIC_DIR=./data/music
# Stops Musicdrome writing into the library — acquisition imports refuse to run.
MUSIC_READ_ONLY=false
# The bind-mount mode compose uses for MUSIC_DIR. Set this to `ro` as well when
# MUSIC_READ_ONLY=true if you want the kernel to enforce it, not just the app.
MUSIC_MOUNT_MODE=rw
# Database, cover-art cache, artist images, logs
DATA_DIR=./data/config
# Transcode cache — safe to delete at any time
CACHE_DIR=./data/cache
# Downloaded podcast episodes
PODCAST_DIR=./data/podcasts
# Staging area for yt-dlp acquisitions before they are imported into MUSIC_DIR
DOWNLOAD_DIR=./data/downloads

# ─── Security ──────────────────────────────────────────────────────────────
# REQUIRED. Signs JWTs. Changing it logs everybody out.
SECRET_KEY=
# REQUIRED. Fernet key encrypting stored third-party credentials and the
# reversible password copy that Subsonic token auth needs. Changing it
# invalidates every stored credential.
CREDENTIAL_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Let anyone create an account from the login screen
ALLOW_OPEN_REGISTRATION=false
# Bootstrap admin, created on first start only. Leave password blank and one
# is generated and printed to the container log.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
# Reject Subsonic clients that send the password in cleartext (?p=)
SUBSONIC_REQUIRE_TOKEN_AUTH=false

# ─── Library scanner ───────────────────────────────────────────────────────
SCAN_ON_STARTUP=true
SCAN_INTERVAL_MINUTES=60
# Watch the filesystem and pick up changes immediately
SCAN_WATCH_FILESYSTEM=true
SCAN_EXTENSIONS=mp3,flac,ogg,oga,opus,m4a,m4b,aac,wav,wma,aiff,aif,ape,mpc,wv
SCAN_IGNORE_PATTERNS=@eaDir,.AppleDouble,#recycle,.stfolder,lost+found
# Filenames searched for album art, in order
COVER_ART_NAMES=cover,folder,front,album,albumart,thumb
# Treat these tag values as separators for multi-value artist/genre fields
MULTIVALUE_SEPARATORS=;,/,feat.,ft.
# Group albums by MusicBrainz release ID when present, else artist+album
ALBUM_GROUPING=musicbrainz

# ─── Transcoding ───────────────────────────────────────────────────────────
TRANSCODING_ENABLED=true
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# Format sent when a client asks for transcoding without naming one
DEFAULT_TRANSCODE_FORMAT=mp3
# Ceiling applied to every stream, kbps. 0 = unlimited.
DEFAULT_MAX_BITRATE=320
# Cache finished transcodes on disk so repeat plays are free
TRANSCODE_CACHE_ENABLED=true
TRANSCODE_CACHE_SIZE_MB=2048
# Concurrent ffmpeg processes
TRANSCODE_MAX_CONCURRENT=4

# ─── Last.fm ───────────────────────────────────────────────────────────────
# Get a key at https://www.last.fm/api/account/create
LASTFM_ENABLED=true
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_SCROBBLE_ENABLED=true
# Pull similar-artist / similar-track data to feed recommendations
LASTFM_FETCH_SIMILAR=true
LASTFM_LANGUAGE=en

# ─── ListenBrainz ──────────────────────────────────────────────────────────
LISTENBRAINZ_ENABLED=true
LISTENBRAINZ_API_URL=https://api.listenbrainz.org
LISTENBRAINZ_SCROBBLE_ENABLED=true
# Per-user tokens are set in the web UI; this is an optional server default
LISTENBRAINZ_TOKEN=

# ─── MusicBrainz ───────────────────────────────────────────────────────────
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2
# Seconds between requests. MusicBrainz requires >= 1.0 for the public server.
MUSICBRAINZ_RATE_LIMIT=1.0
MUSICBRAINZ_USER_AGENT=Musicdrome/1.0.0 ( https://github.com/dean1850/musicdrome )
# Enrich tracks that already carry an MBID, or attempt lookup for all
MUSICBRAINZ_ENRICH_MODE=all

# ─── AI ────────────────────────────────────────────────────────────────────
AI_ENABLED=true
# anthropic | ollama | openai
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Thinking depth / token spend: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Any OpenAI-compatible endpoint (OpenAI, LM Studio, vLLM, OpenRouter, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AI_MAX_TOKENS=8192
# Applies to the ollama/openai providers only — Claude models reject sampling
# parameters, so Musicdrome never sends temperature to Anthropic.
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=180
# How often AI-curated playlists are regenerated
AI_PLAYLIST_REFRESH_HOURS=24
# How often the listening-analytics report is rebuilt
AI_ANALYTICS_REFRESH_HOURS=24
# Skip AI profiling for users with fewer plays than this
AI_MIN_PLAYS_FOR_PROFILE=20
# Tracks handed to the model as context when curating
AI_CONTEXT_TRACK_LIMIT=300

# ─── Smart playlists ───────────────────────────────────────────────────────
SMART_PLAYLIST_ENABLED=true
SMART_PLAYLIST_REFRESH_MINUTES=60
SMART_PLAYLIST_MAX_TRACKS=100
# Create the built-in starter set (Recently Added, Forgotten Gems, ...) for
# each new user
SMART_PLAYLIST_SEED_DEFAULTS=true

# ─── Podcasts ──────────────────────────────────────────────────────────────
PODCAST_ENABLED=true
PODCAST_REFRESH_HOURS=6
# Download new episodes as they appear instead of streaming on demand
PODCAST_AUTO_DOWNLOAD=false
# Episodes kept on disk per channel when auto-download is on. 0 = keep all.
PODCAST_KEEP_EPISODES=10
PODCAST_MAX_CONCURRENT_DOWNLOADS=2

# ─── Lidarr ────────────────────────────────────────────────────────────────
LIDARR_ENABLED=false
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=
# Root folder *as Lidarr sees it*
LIDARR_ROOT_FOLDER=/music
LIDARR_QUALITY_PROFILE_ID=1
LIDARR_METADATA_PROFILE_ID=1
# all | future | missing | existing | latest | first | none
LIDARR_MONITOR_MODE=all
LIDARR_SYNC_INTERVAL_MINUTES=30
# Push wanted artists/albums from Musicdrome into Lidarr
LIDARR_PUSH_WANTED=true
# Poll Lidarr for imported releases and rescan those paths
LIDARR_PULL_IMPORTED=true
# Ask Lidarr to search indexers immediately when an artist is pushed
LIDARR_SEARCH_ON_ADD=true

# ─── Acquisition (yt-dlp) ──────────────────────────────────────────────────
ACQUISITION_ENABLED=true
# false = recommendations queue up as "Wanted" and wait for your approval.
# true  = anything above ACQUISITION_MIN_CONFIDENCE downloads on its own.
AUTO_DOWNLOAD=false
YTDLP_FORMAT=bestaudio/best
YTDLP_AUDIO_FORMAT=mp3
# 0 = best, 9 = worst (VBR quality passed to ffmpeg)
YTDLP_AUDIO_QUALITY=0
# Optional Netscape-format cookies file, path inside the container
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
YTDLP_RATE_LIMIT=
ACQUISITION_MAX_CONCURRENT=2
ACQUISITION_MIN_CONFIDENCE=0.7
# Safety valve on unattended downloads
ACQUISITION_MAX_PER_DAY=25
ACQUISITION_SEARCH_PREFIX=ytsearch5
# Where imported files land, relative to MUSIC_DIR
ACQUISITION_IMPORT_TEMPLATE={artist}/{album}/{track:02d} - {title}.{ext}

# ─── Recommendations ───────────────────────────────────────────────────────
RECOMMENDATIONS_ENABLED=true
RECOMMENDATION_REFRESH_HOURS=12
# Any of: lastfm, listenbrainz, ai
RECOMMENDATION_SOURCES=lastfm,listenbrainz,ai
RECOMMENDATION_LIMIT=50

# ─── Playwright / test harness ─────────────────────────────────────────────
# Only read by the test compose profile
E2E_BASE_URL=http://musicdrome:4533
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=testadmin123
