# ═══════════════════════════════════════════════════════════════════════════
#  Musicdrome configuration — copy to .env and fill in.
#
#  Only three things have no working default: where your music lives, who you
#  are on Last.fm or ListenBrainz, and which AI to think about it with.
#
#  Scan schedule, batch size, auto-download threshold and retention are not in
#  this file. They live in the Settings tab and take effect without a restart.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Paths on this machine ────────────────────────────────────────────────
# Your library. Downloads are filed into it as Artist/Album/01 - Title.mp3,
# and it is scanned for artist/title tags so nothing you already own gets
# suggested to you. Must be writable.
MUSIC_LOCATION=/mnt/lan-mount/media/music
# Just the SQLite database. Somewhere local and fast, not the NAS.
DATA_LOCATION=/mnt/local-ssd/docker_containers/arr-stack/musicdrome/data

# ─── You ──────────────────────────────────────────────────────────────────
# One listener. A Last.fm API key is free and instant:
# https://www.last.fm/api/account/create
#
# Only the key is needed. Musicdrome reads your scrobbles and never writes, so
# there is deliberately no LASTFM_API_SECRET — the shared secret only signs
# write calls (scrobble, love, now-playing), which this app never makes.
LASTFM_API_KEY=
LASTFM_USER=

# ListenBrainz needs only a username for a public profile. The token is
# optional and only required if your listens are private.
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=

# ─── Navidrome — what you hearted ─────────────────────────────────────────
# Optional, and the single best thing you can add here. Scrobbles say what you
# played; a starred track says what you went back and chose. There are far
# fewer of them and every one is deliberate, so the recommender weights them
# much more heavily — both in the prompt and in the score afterwards.
#
# THERE IS NO NAVIDROME API KEY. Navidrome's Subsonic API authenticates a user
# with a password; its native API wants a JWT and its own documentation asks
# you not to use it. So this is your Navidrome login. Musicdrome never sends
# the password: every request carries an MD5 of it salted with fresh random
# bytes, which is what Subsonic clients have always done.
#
# It only ever reads — ping, getStarred2 and search3, none of which write. If
# handing over an admin login bothers you, make an ordinary Navidrome user for
# this; hearts are per-user, so star from the same account you name here or
# there will be nothing to read.
#
# Leave NAVIDROME_URL empty and none of this happens. Reachable from inside the
# container: a hostname on the same compose network, not localhost.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Hearts arrive in one request and are re-read on every scan. Play counts do
# not — Subsonic has no "songs I have played" call, so they are collected by
# paging through the whole library, which is ~40 requests for 20,000 tracks.
# That walk is cached for this many seconds instead of repeating every scan.
#
# Set NAVIDROME_LIBRARY_PAGE=0 to skip the walk entirely and use hearts alone.
NAVIDROME_LIBRARY_MAX_AGE=21600
NAVIDROME_LIBRARY_PAGE=500
NAVIDROME_MAX_TRACKS=100000

# ─── AI backend — pick one ────────────────────────────────────────────────
# anthropic | openai | ollama
AI_PROVIDER=ollama

# Local and free. Point this at the Ollama you already run.
#
# Behind gluetun, `host.docker.internal` does not resolve — the container
# shares gluetun's network namespace, and Docker refuses extra_hosts there. Use
# the host's LAN address instead (http://192.168.1.5:11434) and allow it out of
# the tunnel with gluetun's FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# How much context Ollama is given. Left unset, each request is sized from what
# it sends and expects back, so a forty-track scan gets a bigger window than a
# taste summary and neither wastes VRAM.
#
# This is worth knowing about if scans fail with "could not parse JSON from the
# model response". Ollama's own default is commonly 4096 tokens and it drops
# whatever does not fit *without saying so*, so the model answers with a reply
# that stops mid-token — which looks exactly like a model that cannot follow
# instructions and is really a window too small for the question.
#
# The ceiling on the automatic sizing. Raise it for large batch sizes, lower it
# if Ollama is spilling into system RAM: the KV cache for an 8B model runs to
# about 128 KB per token, so 16384 holds roughly 2 GB for the length of a call.
# OLLAMA_MAX_NUM_CTX=16384
#
# Or pin one window for every request, ignoring the sizing above.
# OLLAMA_NUM_CTX=

# ANTHROPIC_API_KEY=
# Defaults to claude-opus-5. claude-haiku-4-5 is much cheaper and perfectly
# capable of one recommendation call per scan.
# ANTHROPIC_MODEL=claude-opus-5

# Works with OpenAI, LM Studio, vLLM or anything else OpenAI-compatible.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Server ───────────────────────────────────────────────────────────────
# Behind gluetun this port is published by the gluetun service, not this one.
MUSICDROME_PORT=3046
TZ=Australia/Sydney

# Who Musicdrome runs as, and therefore who owns every file it downloads.
#
# Root is the default because it is the one setting that works with no host
# configuration at all — the usual MUSIC_LOCATION is a NAS share or a media
# directory owned by root, and a dropped-privilege process cannot write to it.
# That failure lands at the very end of a download, after the audio has been
# fetched and encoded, which is why the safe default won.
#
# Running as yourself is better practice and fully supported. Set these to your
# own `id -u` / `id -g` — usually 1000/1000 for the first account on the host —
# and Musicdrome adapts: it hands the existing /config to that uid on the next
# boot, so switching is not a one-way door.
#
#   PUID=1000
#   PGID=1000
#
# The one thing it cannot do for you is change who owns MUSIC_LOCATION, and how
# you do that depends entirely on what kind of mount it is:
#
#   Local disk, ZFS, unRAID   sudo chown -R 1000:1000 /path/to/music
#   CIFS/SMB                  uid=1000,gid=1000,file_mode=0664,dir_mode=0775
#                             as mount options in /etc/fstab. `chown` on a CIFS
#                             mount silently does nothing — ownership is decided
#                             entirely by how it was mounted.
#   NFS                       match the uid on the server, or map it with
#                             anonuid; root_squash will block uid 0 anyway.
#
# Get that right and every file Musicdrome writes is owned by you. Get it wrong
# and downloads fail — but they fail loudly: Musicdrome probes both directories
# at boot and names the uid it is running as against the uid that owns them.
PUID=0
PGID=0

# Permission mask for what gets created. 022 gives rw-r--r-- files and
# rwxr-xr-x directories, which is what other media servers need to read them.
# Use 002 instead if you share the library with a group.
UMASK=022

# ═══════════════════════════════════════════════════════════════════════════
#  Everything below is optional. The defaults are the right answer until a
#  download starts failing.
# ═══════════════════════════════════════════════════════════════════════════

# ─── When YouTube answers 403 ─────────────────────────────────────────────
# The search succeeds, the metadata call succeeds, and then the media fetch is
# refused. That is YouTube declining the connection, not the track — and the
# usual reason is the address it comes from. VPN and datacenter exits are
# blocked routinely, which is worth knowing if Musicdrome runs behind gluetun.
#
# Four things push back, and all four are on by default:
#
#   1. The TLS handshake impersonates Chrome, so the connection stops looking
#      like a python script. This needs curl_cffi, which the image installs —
#      "chrome", "safari", "firefox", or empty to disable. If yt-dlp cannot
#      impersonate (usually a curl_cffi outside the version range yt-dlp
#      accepts), downloads carry on without it and the boot log says so on the
#      "tls:" line — it is never a reason to stop downloading.
# YTDLP_IMPERSONATE=chrome
#
#   2. A 403 mid-download is retried against freshly extracted URLs, because a
#      signed media URL that has gone stale produces exactly this error.
# YTDLP_403_RETRIES=2
#
#   3. Then the next-best candidate is tried — a different upload of the same
#      track is often served without complaint.
#
#   4. And after this many refusals in a row the queue pauses for this many
#      seconds, rather than converting every remaining track into a failure.
# YTDLP_403_STREAK=3
# YTDLP_403_COOLDOWN=300
#
# Still refused? Give yt-dlp a signed-in identity. Export cookies to a
# Netscape-format file, or supply a PO token as "<client>.<context>+<token>".
# YTDLP_COOKIES_FILE=/config/cookies.txt
# YTDLP_PO_TOKEN=

# ─── Audio ────────────────────────────────────────────────────────────────
# opus | m4a | mp3 | flac. Opus is the default because it is what YouTube and
# YouTube Music actually serve: their best audio stream is Opus at around 160
# kbps, so Musicdrome asks for that stream and ffmpeg copies it into an .opus
# file without re-encoding it. The file is the source, exactly.
#
# The bitrate is therefore not used on that path at all — it applies only to
# the occasional track served as AAC instead, which has to be converted. 256 is
# well past the point where a difference has been demonstrated, which is the
# whole reason to use it: re-encoding cannot recover what the AAC encoder
# already threw away, so the number is buying certainty rather than quality.
#
# The Downloads tab says which of the two happened for every track, so this is
# checkable rather than a matter of trust.
#
# "mp3"/"320" was the old default and still works. It costs a second lossy
# encode of an already-lossy source, for a file about twice the size that is
# fractionally *worse* than what YouTube sent. Worth it for a car stereo from
# 2009; not for anything a library server can transcode on the fly.
# AUDIO_FORMAT=opus
# AUDIO_BITRATE=256

# ─── Rarely needed ────────────────────────────────────────────────────────
# MUSICDROME_LOG_LEVEL=info
# DOWNLOAD_CONCURRENCY=2

# The name of the playlist every download is added to, in <music>/_playlists.
# MUSICDROME_PLAYLIST_NAME=Musicdrome

# YouTube breaks yt-dlp every few months; the container updates it at boot so a
# restart picks up the fix. Set false to pin the version baked into the image.
# YTDLP_AUTO_UPDATE=true

# Which YouTube player clients yt-dlp may use. Leave this unset. Empty means
# yt-dlp picks, and its choice moves with YouTube; a list written here freezes
# that decision forever — which is how this once ended up leading with the two
# clients YouTube had just moved to SABR-only delivery (yt-dlp/yt-dlp#12482).
# YTDLP_PLAYER_CLIENTS=

# The clients that do serve real format URLs need a JavaScript runtime to solve
# YouTube's signature and n-challenges. The image ships Deno and the solver
# scripts; clearing either of these breaks YouTube downloads outright. Mind the
# minimums — yt-dlp ignores anything older, which looks identical to having no
# runtime at all: downloads fail with 403. Deno 2.3+, Node 22+ (Debian's 18/20
# is *not* enough), QuickJS 2023-12-9+.
# YTDLP_JS_RUNTIMES=deno
# YTDLP_REMOTE_COMPONENTS=ejs:github

# Some hosts advertise IPv6 but cannot route to googlevideo.com, which shows up
# as EAI_AGAIN. This binds yt-dlp to IPv4.
# YTDLP_FORCE_IPV4=false

# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_PROXY=
# YTDLP_RATE_LIMIT=
