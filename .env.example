# ═══════════════════════════════════════════════════════════════════════════
#  Musicdrome configuration
#
#  Copy to .env and fill in the two things that have no default: where your
#  listening history lives, and which AI you want to think about it.
#
#  Everything else here already works as it stands. Scan schedule, batch size,
#  auto-download threshold and retention are not in this file — they live in
#  the Settings tab, and take effect without a restart.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Listening history — set at least one ─────────────────────────────────
# A Last.fm API key is free and instant: https://www.last.fm/api/account/create
# Only the key is needed. Musicdrome reads your scrobbles and never writes, so
# there is deliberately no LASTFM_API_SECRET here — the shared secret only
# signs write calls (scrobble, love, now-playing), which this app never makes.
#
# The API key belongs to Musicdrome, not to a person, so one key covers the
# whole household. The usernames below seed the *first* listener; everyone
# else is added in the Settings tab, each with their own scrobble accounts.
LASTFM_API_KEY=
LASTFM_USER=

# ListenBrainz needs only a username for a public profile. The token is
# optional and only required if your listens are private.
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=

# ─── Navidrome — optional, for importing your household ───────────────────
# Only used to save typing: Musicdrome asks Navidrome who has an account and
# adds them as listeners. Listing users is an admin-only call, so these have to
# be admin credentials. Nothing is ever written back to Navidrome.
#
# It cannot discover anybody's Last.fm account. Navidrome keeps each user's
# scrobble session private and never exposes it over the API, so the names come
# across automatically and the scrobble usernames are filled in once per person
# in the Settings tab.
#
# Use a LAN IP, not localhost — the container has to reach it.
# NAVIDROME_URL=http://192.168.1.5:4533
# NAVIDROME_USER=admin
# NAVIDROME_PASSWORD=

# ─── AI backend — pick one ────────────────────────────────────────────────
# anthropic | openai | ollama
AI_PROVIDER=ollama

# Local and free. Point this at the Ollama you already run.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ANTHROPIC_API_KEY=
# Defaults to claude-opus-5. claude-haiku-4-5 is a much cheaper option and is
# perfectly capable of one recommendation call per scan.
# ANTHROPIC_MODEL=claude-opus-5

# Works with OpenAI, LM Studio, vLLM or anything else OpenAI-compatible.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Paths (host side) ────────────────────────────────────────────────────
# Downloads are filed here as Artist/Album/01 - Title.mp3
MUSIC_DIR=./data/music
# The SQLite database
DATA_DIR=./data/config

# Optional. An existing library to read artist/title tags from, so Musicdrome
# never suggests something you already own. Mounted read-only and never
# written to. Leave empty if you have none.
EXCLUDE_MUSIC_DIR=

# ─── Server ───────────────────────────────────────────────────────────────
MUSICDROME_PORT=3046
TZ=Europe/London

# ─── Who downloaded files belong to ───────────────────────────────────────
# Root by default, and deliberately. The most common way for Musicdrome to
# look healthy while downloading nothing is a MUSIC_DIR the container cannot
# write to — a NAS share, or a media directory owned by root. That failure
# lands at the very end of a download, after the audio has been fetched and
# encoded, and the only clue in the log is "Permission denied".
#
# Running as root sidesteps it entirely. The cost is that downloaded files are
# owned by root, so UMASK below keeps them readable by everyone else — Plex,
# Navidrome and Jellyfin can all still serve them.
#
# If you would rather not run as root, set these to your own id (`id -u`,
# `id -g`) and make sure that user can write to MUSIC_DIR:
#
#     PUID=1000
#     PGID=1000
#     sudo chown -R 1000:1000 /path/to/music        # local disk or ZFS
#     # CIFS/SMB: mount with uid=1000,gid=1000,file_mode=0664,dir_mode=0775
#     # NFS: match the uid on the server, or map it with anonuid
#
# Musicdrome checks this at boot and says so plainly if it cannot write.
PUID=0
PGID=0

# Permission mask for downloaded files. 022 gives rw-r--r-- files and
# rwxr-xr-x directories, which is what other media servers need to read them.
# 002 instead if you share the library with a group.
UMASK=022

# ─── Audio ────────────────────────────────────────────────────────────────
# mp3 | m4a | opus | flac. MP3 at 320 plays on everything, which is why it is
# the default — but YouTube serves Opus at around 160 kbps, so re-encoding to
# MP3 320 makes a file about twice the size that is fractionally *worse* than
# the source. "opus" or "m4a" keeps the original bytes with no second encode.
# AUDIO_FORMAT=mp3
# AUDIO_BITRATE=320

# ─── Rarely needed ────────────────────────────────────────────────────────
# MUSICDROME_LOG_LEVEL=info

# YouTube breaks yt-dlp every few months; the container updates it at boot so a
# restart picks up the fix. Set false to pin the version baked into the image.
# YTDLP_AUTO_UPDATE=true

# Which YouTube player clients yt-dlp may try, in order. The default `web`
# client needs a JavaScript runtime this container does not have, and returns
# no audio formats without one — which is why ios and android lead. Only worth
# changing if downloads start failing and a different order helps.
# Which YouTube player clients yt-dlp may use. Leave this unset. Empty means
# yt-dlp picks, and its choice moves with YouTube; a list written here freezes
# that decision forever.
#
# This setting used to default to "ios,android,..." — and then YouTube moved
# both onto SABR-only delivery, where the player response carries no format
# URLs at all. The result was a log full of "Some android client https formats
# have been skipped as they are missing a URL" (yt-dlp/yt-dlp#12482) on every
# single track. Set it only to work around a live breakage, and clear it after.
# YTDLP_PLAYER_CLIENTS=

# The clients that still serve real format URLs need a JavaScript runtime to
# solve YouTube's signature and n-challenges, plus yt-dlp's solver scripts.
# The image ships Deno and the scripts. Clearing either of these will break
# YouTube downloads.
#
# Only change this to name a runtime you have installed yourself, and mind the
# minimums — yt-dlp ignores anything older, which looks identical to having no
# runtime at all: downloads fail with HTTP 403. Deno needs 2.3+, Node 22+
# (Debian's 18/20 is *not* enough), QuickJS 2023-12-9+.
# YTDLP_JS_RUNTIMES=deno
# YTDLP_REMOTE_COMPONENTS=ejs:github

# If YouTube starts demanding a sign-in on your IP, either export cookies to a
# Netscape-format file or hand yt-dlp a PO token (<client>.<context>+<token>).
# YTDLP_COOKIES_FILE=/config/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_PO_TOKEN=

# Some hosts advertise IPv6 but cannot route to googlevideo.com, which shows up
# as EAI_AGAIN. This binds yt-dlp to IPv4.
# YTDLP_FORCE_IPV4=false

# YTDLP_PROXY=
# YTDLP_RATE_LIMIT=
# DOWNLOAD_CONCURRENCY=2
